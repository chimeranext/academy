# Academy prod — copy to .env, never commit secrets.
# Neon academy-prod project (pooled):
DATABASE_URL=postgresql://user:pass@ep-prod-pool.neon.tech/academy-prod?sslmode=require
NUXT_AUTH_SECRET=change-me-prod-32-chars-min
# Bunny prod keys:
NUXT_PUBLIC_VIDEO_CDN=https://chimera-academy.b-cdn.net
NUXT_PUBLIC_SITE_URL=https://academy.chimeranext.dev
# Issuer Ed25519 (did:web:academy.chimeranext.dev) — prod keypair, server-side only:
OB3_ISSUER_PRIVATE_KEY_MULTIBASE=replace-me
